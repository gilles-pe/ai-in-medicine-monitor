{
  "name": "ai-in-medicine-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source-backed mobile dashboard for AI in medicine",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
